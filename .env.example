# Postgres for users, attempts, review schedule, and the pg-boss job queue.
DATABASE_URL=postgres://flashcode:flashcode@localhost:5432/flashcode

# Signs the guest-user cookie. Required in production. `openssl rand -base64 32`
SESSION_SECRET=

# Where submitted code runs: "local" (your own g++, NOT sandboxed, dev only) or "judge0".
FLASH_RUNNER=local

# Judge0 (hosted on RapidAPI, or your own instance). Only needed when FLASH_RUNNER=judge0.
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
# Defaults to X-RapidAPI-Key for rapidapi.com URLs, X-Auth-Token otherwise.
JUDGE0_API_KEY_HEADER=
# Code is compiled as C++23, so this must be a GCC 11+ language (13+ recommended).
# Ids differ between Judge0 versions: pick the newest "C++ (GCC ...)" from GET /languages.
JUDGE0_LANGUAGE_ID=

FLASH_WORKER_CONCURRENCY=2
