# FlashCode production settings. deploy/setup-server.sh copies this to
# /opt/flashcode/.env on the server and fills in the generated secrets. Edit
# it there (never commit a filled-in copy), then redeploy.

# The public domain. DNS for it (and www.) must point at this server.
SITE_DOMAIN=litecode.io

# Generated on the server by setup-server.sh (openssl rand).
POSTGRES_PASSWORD=
SESSION_SECRET=
BETTER_AUTH_SECRET=
RUNNER_TOKEN=

# Sign-in. Leave a pair empty to hide that button.
# GitHub OAuth app callback: https://<SITE_DOMAIN>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client callback: https://<SITE_DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sizing for a 2 vCPU / 4 GB machine. Raise together on a bigger one.
WORKER_CONCURRENCY=2
RUNNER_SLOTS=2
RUNNER_MEMORY=2g
